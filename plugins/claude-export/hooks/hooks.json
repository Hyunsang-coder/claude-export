{
  "description": "Append last assistant response to claude-exports/{session_id}.md on every Stop",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/export-last-response.sh\""
          }
        ]
      }
    ]
  }
}
